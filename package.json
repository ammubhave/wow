{
  "name": "wow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm decrypt && vp dev --port 3000",
    "build": "CLOUDFLARE_ENV=production vp build",
    "serve": "vp preview",
    "test": "vp test run",
    "deploy": "wrangler deploy --env production",
    "format": "vp fmt",
    "lint": "vp lint --type-check --type-aware",
    "postinstall": "concurrently 'wrangler types --strict-vars=false' 'pnpm auth:generate'",
    "prepare": "vp config",
    "decrypt": "dotenvx decrypt --env-file .env.local.encrypted --stdout | node -e \"process.stdout.write(require('fs').readFileSync(0,'utf8').slice(0,-1))\" > .env.local",
    "encrypt": "dotenvx encrypt --env-file .env.local --stdout | node -e \"process.stdout.write(require('fs').readFileSync(0,'utf8').slice(0,-1))\" > .env.local.encrypted",
    "auth:generate": "touch src/lib/db/auth-schema.ts && auth generate --config src/lib/auth.ts --output src/lib/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate && node scripts/check-d1-migrations.mjs",
    "db:migrate": "mkdir -p .wrangler/state/v3/d1/miniflare-D1DatabaseObject/ && node scripts/check-d1-migrations.mjs && drizzle-kit migrate",
    "db:migrate:prod": "node scripts/check-d1-migrations.mjs && node scripts/migrate-d1-prod.mjs",
    "db:seed:exchange": "node scripts/seed-exchange-dev.mjs",
    "db:seed:activity": "node scripts/seed-activity-dev.mjs"
  },
  "dependencies": {
