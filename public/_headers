# Cloudflare static asset headers (https://developers.cloudflare.com/workers/static-assets/headers/).
# Everything under /assets/ is emitted by Vite with a content hash in its name, so a given URL never
# changes: browsers can keep it for a year without asking again. (The default, max-age=0, made every
# visit revalidate all ~75 files the app shell loads.)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The sheet's word list: the file name changes with its contents (scripts/build-wordlist.mjs).
/wordlist/words-*
  Cache-Control: public, max-age=31536000, immutable
