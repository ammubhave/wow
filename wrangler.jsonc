{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wow",
  "account_id": "ff0f90cb5a46c881c601b8f3c650c60e",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "observability": {
    "enabled": true,
    "traces": {"enabled": true},
    // Also exported to PostHog Logs (a destination set up in the Cloudflare dashboard).
    "logs": {"enabled": true, "destinations": ["posthog-logs"]},
  },
  "placement": {"mode": "smart"},
  // Hourly: imports Cloudflare usage (src/server/usage-import.ts); every 6 hours also refreshes hunt
  // listings from the puzzle hunt calendars (src/server/hunt-calendar.ts).
  "triggers": {"crons": ["17 * * * *"]},
  // A pure SPA: no page is rendered on the server. The app shell is a static file (TanStack Start
  // SPA mode writes it to index.html at build), so page loads are served from static assets
  // without running the Worker: a navigation to a URL with no matching file gets index.html. The
  // Worker only serves /api/* (always, including navigations to it: OAuth callbacks, email
  // verification links), plus non-navigation requests that match no file.
  "assets": {"not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wow",
      "database_id": "33287a33-35b9-47c0-8c7f-2e2d79a73a54",
    },
  ],
  "vars": {
    "VITE_DISCORD_CLIENT_ID": "1282113902745878628",
    "VITE_PUBLIC_POSTHOG_KEY": "phc_zNIaWFEMEDxxaRQdE9sl64tBazbyXPx4yHMNaHonP1W",
    "VITE_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
    "VITE_GOOGLE_API_KEY": "AIzaSyDMX41xfdC8Vy6Uf2rpmcvGIy3dnmP1D98",
    "VITE_GOOGLE_API_CLIENT_ID": "933519172272-179lstu86fd5blof9d6las41m1r9mdt7.apps.googleusercontent.com",
    "GOOGLE_CLIENT_ID": "933519172272-h905jlmbp8m1egsjs5ocsri5fhihs94b.apps.googleusercontent.com",
    "VITE_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAACJXjlC9B02DfnTb",
    // Web Push: the public half of the VAPID key pair (VAPID_PRIVATE_KEY is a secret).
    "VITE_PUBLIC_VAPID_KEY": "BIucW0kh-6IMEclSv2gMr9y4HTdL14ck2ah2AywO_7ChYqbyBKR6m1_VMPzc19zR6146RhwWvmeaIpxCgPOGB6I",
    "BETTER_AUTH_URL": "http://localhost:3000",
    "BETTER_AUTH_SECRET": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "PNPM_VERSION": "12.8.1",
    "ADMIN_EMAILS": "amol@amolbhave.com,allenpark93@gmail.com",
    "SFU_APP_ID": "f34b8034e0479c66588a2bcc5a3c88da",
    "TURN_SERVER_APP_ID": "4d9169bd6c62a93238fe4406cec48e08",
    // For the usage import (src/server/usage-import.ts, with the CF_ANALYTICS_TOKEN secret): the
    // account, and this environment's Worker, D1 database and R2 bucket.
    "CLOUDFLARE_ACCOUNT_ID": "ff0f90cb5a46c881c601b8f3c650c60e",
    "USAGE_SOURCES": {
      "script": "wow",
      "d1DatabaseId": "33287a33-35b9-47c0-8c7f-2e2d79a73a54",
      "r2Bucket": "wow",
      // The usage dataset (analytics_engine_datasets), read back to work out costs.
      "dataset": "wow_usage_dev",
    },
  },
  "durable_objects": {
    "bindings": [
      {"name": "CHAT_ROOMS", "class_name": "ChatRoomV2"},
      {"name": "NOTIFICATION_ROOMS", "class_name": "NotificationRoomV2"},
      {"name": "PRESENCE_ROOMS", "class_name": "PresenceRoomV2"},
      {"name": "DISCORD_CLIENT", "class_name": "DiscordClientV2"},
      {"name": "WORKSPACE_ROOMS", "class_name": "WorkspaceRoomV2"},
      {"name": "WHITEBOARD_ROOMS", "class_name": "WhiteboardRoom"},
      {"name": "SHEET_ROOMS", "class_name": "SheetRoom"},
      // The old key-value-backed classes, read only to copy their data into the SQLite ones above
      // (src/server/do/kv-migration.ts). PresenceRoom stored nothing, so it needs no binding.
      {"name": "CHAT_ROOMS_KV", "class_name": "ChatRoom"},
      {"name": "NOTIFICATION_ROOMS_KV", "class_name": "NotificationRoom"},
      {"name": "DISCORD_CLIENT_KV", "class_name": "DiscordClient"},
      {"name": "WORKSPACE_ROOMS_KV", "class_name": "WorkspaceRoom"},
    ],
  },
  "r2_buckets": [{"binding": "R2", "bucket_name": "wow"}],
  // Rate limits (see src/lib/auth-rate-limit.ts and workspaces.join): the numbers here are the
  // limits, so keep them in step with the code. Production uses its own namespaces.
  "ratelimits": [
    {"name": "AUTH_RATE_LIMIT", "namespace_id": "7101", "simple": {"limit": 100, "period": 10}},
    {
      "name": "AUTH_SIGN_IN_RATE_LIMIT",
      "namespace_id": "7102",
      "simple": {"limit": 10, "period": 10},
    },
    {"name": "AUTH_EMAIL_RATE_LIMIT", "namespace_id": "7103", "simple": {"limit": 5, "period": 60}},
    {"name": "JOIN_RATE_LIMIT", "namespace_id": "7104", "simple": {"limit": 5, "period": 60}},
  ],
  // Per-request usage counts (src/server/usage.ts), for attributing running costs to teams.
  "analytics_engine_datasets": [{"binding": "USAGE", "dataset": "wow_usage_dev"}],
  // Cloudflare Email Service (wafflehaus.io is onboarded). Simulated in local dev: emails are logged,
  // not sent.
  "send_email": [{"name": "EMAIL", "allowed_sender_addresses": ["noreply@wafflehaus.io"]}],
  "migrations": [
    {"tag": "v1", "new_classes": ["ChatRoom", "NotificationRoom", "PresenceRoom", "DiscordClient"]},
    {"tag": "v2", "new_classes": ["WorkspaceRoom"]},
    {"tag": "v3", "new_sqlite_classes": ["WhiteboardRoom"]},
    {"tag": "v4", "new_sqlite_classes": ["SheetRoom"]},
    // SQLite-backed successors of the v1/v2 key-value classes, which can't be switched in place.
    {
      "tag": "v5",
      "new_sqlite_classes": [
        "ChatRoomV2",
        "NotificationRoomV2",
        "PresenceRoomV2",
        "DiscordClientV2",
        "WorkspaceRoomV2",
      ],
    },
  ],
  "workflows": [
    {
      "name": "DeleteChannelAfterDelayWorkflow",
      "binding": "DELETE_CHANNEL_AFTER_DELAY_WORKFLOW",
      "class_name": "DeleteChannelAfterDelayWorkflow",
    },
    {
      // Removes a deleted puzzle's chat, whiteboard, sheet, images and Google file
      // (src/server/puzzle-cleanup.ts).
      "name": "PuzzleCleanupWorkflow",
      "binding": "PUZZLE_CLEANUP_WORKFLOW",
      "class_name": "PuzzleCleanupWorkflow",
    },
    {
      // Shares a workspace's Drive folder with members and takes it away from former ones
      // (src/server/drive-access.ts).
      "name": "DriveAccessWorkflow",
      "binding": "DRIVE_ACCESS_WORKFLOW",
      "class_name": "DriveAccessWorkflow",
    },
    {
      // Deletes WOW's channels from a Discord server disconnected from its workspace.
      "name": "DiscordDisconnectWorkflow",
      "binding": "DISCORD_DISCONNECT_WORKFLOW",
      "class_name": "DiscordDisconnectWorkflow",
    },
    {
      // Sends an email, retrying if Cloudflare Email Service fails (src/server/email.ts).
      "name": "EmailWorkflow",
      "binding": "EMAIL_WORKFLOW",
      "class_name": "EmailWorkflow",
    },
    {
      // Makes a new puzzle's Google Sheet (src/server/puzzle-worksheet.ts).
      "name": "PuzzleSheetWorkflow",
      "binding": "PUZZLE_SHEET_WORKFLOW",
      "class_name": "PuzzleSheetWorkflow",
    },
    {
      // Saves an email sent to a workspace's contact address and tells the team
      // (src/server/inbound-email.ts).
      "name": "InboundEmailWorkflow",
      "binding": "INBOUND_EMAIL_WORKFLOW",
      "class_name": "InboundEmailWorkflow",
    },
  ],
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wow-production",
          "database_id": "dbd210d9-5627-4157-aec9-7d6431e68833",
        },
      ],
      "vars": {
        "VITE_DISCORD_CLIENT_ID": "1282113902745878628",
        "VITE_PUBLIC_POSTHOG_KEY": "phc_zNIaWFEMEDxxaRQdE9sl64tBazbyXPx4yHMNaHonP1W",
        "VITE_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
        "VITE_GOOGLE_API_KEY": "AIzaSyDMX41xfdC8Vy6Uf2rpmcvGIy3dnmP1D98",
        "VITE_GOOGLE_API_CLIENT_ID": "933519172272-179lstu86fd5blof9d6las41m1r9mdt7.apps.googleusercontent.com",
        "GOOGLE_CLIENT_ID": "933519172272-h905jlmbp8m1egsjs5ocsri5fhihs94b.apps.googleusercontent.com",
        "VITE_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAACJXqMR1-nXdolsi",
        // Web Push: the public half of the VAPID key pair (VAPID_PRIVATE_KEY is a secret).
        "VITE_PUBLIC_VAPID_KEY": "BIucW0kh-6IMEclSv2gMr9y4HTdL14ck2ah2AywO_7ChYqbyBKR6m1_VMPzc19zR6146RhwWvmeaIpxCgPOGB6I",
        "BETTER_AUTH_URL": "https://www.wafflehaus.io",
        "PNPM_VERSION": "12.8.1",
        "ADMIN_EMAILS": "amol@amolbhave.com,allenpark93@gmail.com",
        "SFU_APP_ID": "f34b8034e0479c66588a2bcc5a3c88da",
        "TURN_SERVER_APP_ID": "4d9169bd6c62a93238fe4406cec48e08",
        // For the usage import (src/server/usage-import.ts, with the CF_ANALYTICS_TOKEN secret): the
        // account, and this environment's Worker, D1 database and R2 bucket.
        "CLOUDFLARE_ACCOUNT_ID": "ff0f90cb5a46c881c601b8f3c650c60e",
        "USAGE_SOURCES": {
          "script": "wow-production",
          "d1DatabaseId": "dbd210d9-5627-4157-aec9-7d6431e68833",
          "r2Bucket": "wow-production",
          // The usage dataset (analytics_engine_datasets), read back to work out costs.
          "dataset": "wow_usage",
        },
      },
      "durable_objects": {
        "bindings": [
          {"name": "CHAT_ROOMS", "class_name": "ChatRoomV2"},
          {"name": "NOTIFICATION_ROOMS", "class_name": "NotificationRoomV2"},
          {"name": "PRESENCE_ROOMS", "class_name": "PresenceRoomV2"},
          {"name": "DISCORD_CLIENT", "class_name": "DiscordClientV2"},
          {"name": "WORKSPACE_ROOMS", "class_name": "WorkspaceRoomV2"},
          {"name": "WHITEBOARD_ROOMS", "class_name": "WhiteboardRoom"},
          {"name": "SHEET_ROOMS", "class_name": "SheetRoom"},
          // The old key-value-backed classes, read only to copy their data into the SQLite ones above
          // (src/server/do/kv-migration.ts). PresenceRoom stored nothing, so it needs no binding.
          {"name": "CHAT_ROOMS_KV", "class_name": "ChatRoom"},
          {"name": "NOTIFICATION_ROOMS_KV", "class_name": "NotificationRoom"},
          {"name": "DISCORD_CLIENT_KV", "class_name": "DiscordClient"},
          {"name": "WORKSPACE_ROOMS_KV", "class_name": "WorkspaceRoom"},
        ],
      },
      "r2_buckets": [{"binding": "R2", "bucket_name": "wow-production"}],
      // Rate limits (see src/lib/auth-rate-limit.ts and workspaces.join): the numbers here are the
      // limits, so keep them in step with the code. Production uses its own namespaces.
      "ratelimits": [
        {"name": "AUTH_RATE_LIMIT", "namespace_id": "7201", "simple": {"limit": 100, "period": 10}},
        {
          "name": "AUTH_SIGN_IN_RATE_LIMIT",
          "namespace_id": "7202",
          "simple": {"limit": 10, "period": 10},
        },
        {
          "name": "AUTH_EMAIL_RATE_LIMIT",
          "namespace_id": "7203",
          "simple": {"limit": 5, "period": 60},
        },
        {"name": "JOIN_RATE_LIMIT", "namespace_id": "7204", "simple": {"limit": 5, "period": 60}},
      ],
      "analytics_engine_datasets": [{"binding": "USAGE", "dataset": "wow_usage"}],
      "send_email": [{"name": "EMAIL", "allowed_sender_addresses": ["noreply@wafflehaus.io"]}],
      "workflows": [
        {
          "name": "DeleteChannelAfterDelayWorkflow",
          "binding": "DELETE_CHANNEL_AFTER_DELAY_WORKFLOW",
          "class_name": "DeleteChannelAfterDelayWorkflow",
        },
        {
          // Removes a deleted puzzle's chat, whiteboard, sheet, images and Google file
          // (src/server/puzzle-cleanup.ts).
          "name": "PuzzleCleanupWorkflow-production",
          "binding": "PUZZLE_CLEANUP_WORKFLOW",
          "class_name": "PuzzleCleanupWorkflow",
        },
        {
          // Shares a workspace's Drive folder with members and takes it away from former ones
          // (src/server/drive-access.ts).
          "name": "DriveAccessWorkflow-production",
          "binding": "DRIVE_ACCESS_WORKFLOW",
          "class_name": "DriveAccessWorkflow",
        },
        {
          // Deletes WOW's channels from a Discord server disconnected from its workspace.
          "name": "DiscordDisconnectWorkflow-production",
          "binding": "DISCORD_DISCONNECT_WORKFLOW",
          "class_name": "DiscordDisconnectWorkflow",
        },
        {
          // Sends an email, retrying if Cloudflare Email Service fails (src/server/email.ts).
          "name": "EmailWorkflow-production",
          "binding": "EMAIL_WORKFLOW",
          "class_name": "EmailWorkflow",
        },
        {
          // Makes a new puzzle's Google Sheet (src/server/puzzle-worksheet.ts).
          "name": "PuzzleSheetWorkflow-production",
          "binding": "PUZZLE_SHEET_WORKFLOW",
          "class_name": "PuzzleSheetWorkflow",
        },
        {
          // Saves an email sent to a workspace's contact address and tells the team
          // (src/server/inbound-email.ts).
          "name": "InboundEmailWorkflow-production",
          "binding": "INBOUND_EMAIL_WORKFLOW",
          "class_name": "InboundEmailWorkflow",
        },
      ],
    },
  },
}
